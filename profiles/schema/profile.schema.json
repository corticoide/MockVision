{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/corticoide/mockvision/main/profiles/schema/profile.schema.json",
  "title": "MockVision profile",
  "description": "Describes how a camera model and firmware behaves: identity, native parameters, streams, protocol engines and events. Schema version 1.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "profile", "identity", "media", "engines"],
  "properties": {
    "schema": {
      "description": "Profile schema version.",
      "const": 1
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "vendor", "model"],
      "properties": {
        "id": {
          "description": "vendor/model identifier. Required for a loose profile.yaml; in a package it must match the manifest.",
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,62}/[a-z0-9][a-z0-9._-]{0,62}$"
        },
        "version": {
          "description": "Semantic version of the profile content.",
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
        },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "vendor": { "type": "string", "minLength": 1, "maxLength": 64 },
        "model": { "type": "string", "minLength": 1, "maxLength": 64 },
        "firmware": {
          "description": "Firmware versions covered by the profile.",
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 64 }
        },
        "extends": {
          "description": "Installed parent profile, for example milesight/base@^1.",
          "type": "string"
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["serial", "factory"],
      "properties": {
        "serial": {
          "description": "Serial number mask: 9 is a digit, A an uppercase letter, X an uppercase hex digit, a backslash escapes the next character.",
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "oui": {
          "description": "Suggested vendor OUI for the camera MAC (optional).",
          "type": "string",
          "pattern": "^[0-9A-Fa-f]{2}([:-][0-9A-Fa-f]{2}){2}$"
        },
        "factory": {
          "type": "object",
          "additionalProperties": false,
          "required": ["users"],
          "properties": {
            "network": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "ip": { "type": "string", "format": "ipv4" },
                "mask": { "type": "string", "format": "ipv4" },
                "gateway": { "type": "string", "format": "ipv4" }
              }
            },
            "users": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["username", "password", "role"],
                "properties": {
                  "username": { "type": "string", "minLength": 1, "maxLength": 32 },
                  "password": { "type": "string", "minLength": 1, "maxLength": 64 },
                  "role": { "enum": ["admin", "operator", "viewer"] }
                }
              }
            }
          }
        },
        "device": {
          "description": "Device data exposed to templates, such as firmware or hardware versions.",
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "boot_time": {
          "description": "How long the device takes to come back from a reboot; 30s when omitted.",
          "$ref": "#/$defs/duration"
        }
      }
    },
    "state": {
      "description": "Native parameters, named as the vendor names them.",
      "type": "object",
      "propertyNames": { "pattern": "^[A-Za-z0-9_.\\[\\]-]{1,128}$" },
      "additionalProperties": { "$ref": "#/$defs/param" }
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": ["streams"],
      "properties": {
        "streams": {
          "type": "object",
          "required": ["main"],
          "propertyNames": { "enum": ["main", "sub", "third"] },
          "additionalProperties": { "$ref": "#/$defs/stream" }
        }
      }
    },
    "engines": {
      "description": "Engine instances keyed by instance name. Each engine validates its own section.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][a-z0-9_-]{0,31}$" },
      "additionalProperties": {
        "type": "object",
        "required": ["engine"],
        "properties": {
          "engine": {
            "description": "Engine name and version range, for example http-api@^1.",
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,31}@[0-9^~<>=., *xX|-]+$"
          }
        }
      }
    },
    "events": {
      "description": "Events the camera can emit, keyed by canonical type.",
      "type": "object",
      "propertyNames": { "pattern": "^([a-z_]+|custom:[a-z0-9_.-]{1,64})$" },
      "additionalProperties": { "$ref": "#/$defs/event" }
    },
    "vca": {
      "description": "Video analytics: the kinds of rule cameras can draw and the objects they detect.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rules": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["line", "region"] }
        },
        "object_classes": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 64,
          "items": { "type": "string", "minLength": 1, "maxLength": 32 }
        },
        "plate_format": {
          "description": "Plate data format, for example text or text+color.",
          "type": "string"
        },
        "factory_rules": {
          "description": "Rules a new or restored camera has, as the device ships them.",
          "type": "array",
          "maxItems": 16,
          "items": { "$ref": "#/$defs/factory_rule" }
        }
      }
    },
    "storage": {
      "description": "Where the model keeps recordings: an SD card slot, NAS shares, or both.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sd": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_gb"],
          "properties": {
            "max_gb": { "description": "Largest card the slot takes.", "type": "integer", "minimum": 1, "maximum": 1024 }
          }
        },
        "nas": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["nfs", "smb"] }
        }
      }
    },
    "coverage": {
      "description": "What the author declares covered; the importer checks it.",
      "type": "object",
      "additionalProperties": { "type": "string" }
    }
  },
  "$defs": {
    "factory_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "points"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 32 },
        "type": { "enum": ["line", "region"] },
        "points": {
          "description": "Positions from 0 to 1 from the top left corner of the picture: two for a line, 3 to 20 for a region.",
          "type": "array",
          "minItems": 2,
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["x", "y"],
            "properties": {
              "x": { "type": "number", "minimum": 0, "maximum": 1 },
              "y": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          }
        },
        "direction": { "enum": ["A->B", "B->A", "both"] },
        "events": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "object_classes": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 32 } },
        "enabled": { "type": "boolean" }
      }
    },
    "duration": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]+)?(ms|s|m)$"
    },
    "param": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["string", "int", "float", "bool", "enum"] },
        "default": {},
        "values": { "type": "array", "minItems": 1 },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "max_length": { "type": "integer", "minimum": 1 },
        "bind": {
          "description": "Canonical key the parameter drives. Without it the parameter is declarative.",
          "type": "string"
        },
        "map": {
          "description": "The vendor's values and the canonical ones of bind they stand for, such as H.265: h265.",
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": ["string", "integer", "boolean"] }
        },
        "default_from": {
          "description": "Takes the default from the camera's identity, as a device whose name is its serial number.",
          "enum": ["serial", "name", "model", "mac", "ip", "firmware"]
        },
        "description": { "type": "string" }
      }
    },
    "stream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["codecs", "resolutions", "default"],
      "properties": {
        "codecs": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["h264", "h265", "mjpeg"] }
        },
        "resolutions": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^[1-9][0-9]{1,4}x[1-9][0-9]{1,4}$" }
        },
        "fps": { "$ref": "#/$defs/range" },
        "bitrate": { "$ref": "#/$defs/range" },
        "default": {
          "type": "object",
          "additionalProperties": false,
          "required": ["codec", "resolution", "fps"],
          "properties": {
            "codec": { "enum": ["h264", "h265", "mjpeg"] },
            "resolution": { "type": "string" },
            "fps": { "type": "integer", "minimum": 1, "maximum": 60 },
            "bitrate": { "type": "integer", "minimum": 16, "maximum": 100000 },
            "gop": { "type": "integer", "minimum": 1, "maximum": 600 }
          }
        }
      }
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min": { "type": "integer", "minimum": 0 },
        "max": { "type": "integer", "minimum": 0 }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "vendor_name": { "type": "string", "minLength": 1, "maxLength": 64 },
        "min_interval": { "$ref": "#/$defs/duration" },
        "rule": {
          "description": "Kind of rule the event comes from. Omitted: line for line_crossing, region for region_entrance, region_exit, loitering and intrusion, none for the rest.",
          "enum": ["line", "region", "none"]
        },
        "report": {
          "description": "The event carries what the camera counted (for example a people counting report), not an object it saw. Reports come from no rule.",
          "type": "boolean"
        },
        "record": {
          "description": "What the camera stores for the event on its SD card or NAS share: the snapshot and a clip of a stream (main when omitted).",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "snapshot": { "type": "boolean" },
            "clip": { "$ref": "#/$defs/duration" },
            "stream": { "type": "string" }
          }
        },
        "transports": {
          "type": "object",
          "properties": {
            "http_push": { "$ref": "#/$defs/http_push" },
            "mqtt": { "$ref": "#/$defs/mqtt" },
            "ftp": { "$ref": "#/$defs/ftp" },
            "smtp": { "$ref": "#/$defs/smtp" },
            "attach": { "$ref": "#/$defs/attach" }
          },
          "additionalProperties": { "type": "object" }
        },
        "delivery": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "timeout": { "$ref": "#/$defs/duration" },
            "retries": { "type": "integer", "minimum": 0, "maximum": 10 },
            "backoff": { "$ref": "#/$defs/duration" }
          }
        }
      }
    },
    "attach": {
      "description": "A part written to the clients that keep a request open to the camera's events.attach route, as Dahua's eventManager.cgi attach. stop writes a second part after a while, for events that start and stop.",
      "type": "object",
      "additionalProperties": false,
      "required": ["body"],
      "properties": {
        "body": { "type": "string", "minLength": 1 },
        "stop": {
          "type": "object",
          "additionalProperties": false,
          "required": ["after", "body"],
          "properties": {
            "after": { "$ref": "#/$defs/duration" },
            "body": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "http_push": {
      "description": "Event notification by HTTP. Exactly one of template (file in the package) or body (inline template).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "method": { "enum": ["GET", "POST", "PUT"] },
        "content_type": { "type": "string" },
        "headers": { "type": "object", "additionalProperties": { "type": "string" } },
        "template": { "type": "string" },
        "body": { "type": "string" },
        "path": { "type": "string" },
        "image": { "type": "boolean" }
      },
      "oneOf": [
        { "required": ["template"] },
        { "required": ["body"] }
      ]
    },
    "mqtt": {
      "description": "Event published to an MQTT broker (mqtt-publish). The payload is body (inline template) or template (file in the package); a target may replace the topic.",
      "type": "object",
      "additionalProperties": false,
      "required": ["topic"],
      "properties": {
        "topic": { "type": "string", "minLength": 1, "maxLength": 512, "description": "Template of the topic." },
        "qos": { "type": "integer", "minimum": 0, "maximum": 2 },
        "retain": { "type": "boolean" },
        "template": { "type": "string" },
        "body": { "type": "string" },
        "image": { "type": "boolean", "description": "The payload embeds the snapshot (b64 snapshot): up to 8 MB." }
      },
      "oneOf": [
        { "required": ["template"] },
        { "required": ["body"] }
      ]
    },
    "ftp": {
      "description": "File uploaded to an FTP or SFTP server for the event (ftp-upload): the snapshot of a stream, or a document the profile renders. path and file are templates; the directory goes under the target's.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "maxLength": 1024, "description": "Template of the directory, relative to the target's." },
        "file": { "type": "string", "minLength": 1, "maxLength": 512, "description": "Template of the file name." },
        "content": { "enum": ["snapshot", "body"], "description": "snapshot (default) or the rendered body." },
        "stream": { "type": "string", "description": "Stream of the snapshot; main when omitted." },
        "template": { "type": "string" },
        "body": { "type": "string" }
      }
    },
    "smtp": {
      "description": "Mail sent for the event (smtp-mail) to the recipients of each smtp target, with the snapshot attached when snapshot is true.",
      "type": "object",
      "additionalProperties": false,
      "required": ["subject"],
      "properties": {
        "subject": { "type": "string", "minLength": 1, "maxLength": 512, "description": "Template of the subject." },
        "template": { "type": "string" },
        "body": { "type": "string", "description": "Template of the text." },
        "content_type": { "enum": ["text/plain", "text/html"] },
        "snapshot": { "type": "boolean" },
        "stream": { "type": "string", "description": "Stream of the snapshot; main when omitted." },
        "attachment": { "type": "string", "maxLength": 255, "description": "Template of the attachment's file name." }
      },
      "oneOf": [
        { "required": ["template"] },
        { "required": ["body"] }
      ]
    }
  }
}
